# ==============================================================
# 校园知识问答系统 · 环境配置示例
# --------------------------------------------------------------
# 用法：
#   1) 复制本文件为 .env       ->  cp .env.example .env
#   2) 按需修改下面的配置项
#
# 说明：
#   · 全部留空也能跑 —— 系统会自动降级（见文末「降级链」），
#     只是答案由大模型生成退化为「原文摘编」，检索仍可用。
#   · 环境变量优先于 .env 文件；.env 支持 UTF-8 / GBK 编码。
#   · 也可自定义配置文件路径：设置环境变量 SCHOOL_ENV_FILE 指向它。
#   · ⚠️ .env 含密钥，已被 .gitignore 排除，请勿提交到代码仓库。
# ==============================================================

# --------------------------------------------------------------
# 存储
# --------------------------------------------------------------
# SQLite 知识库文件路径（相对项目根目录或绝对路径；不存在会自动建表）
SCHOOL_DB_PATH=data/school_kb.db
# 数据目录：其下应有 raw/（原始文件 + manifest）与 kg/（图谱/FAQ/题库 JSON）
SCHOOL_DATA_DIR=data

# --------------------------------------------------------------
# LLM（可选；OpenAI Chat Completions 兼容）
# --------------------------------------------------------------
# 两种写法等价，任选其一；通用 LLM_* 优先于 DEEPSEEK_*：
#   写法 A（通用）： LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
#   写法 B（DeepSeek 风格）： DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL_NAME
# 只要 key 非空即视为启用，无需显式打开 LLM_ENABLED。
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 单次调用超时（秒）。大模型生成较慢；若前面还有 nginx，其超时需一并放宽
LLM_TIMEOUT=60

# 写法 B（DeepSeek 风格；注释掉即不生效）：
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL_NAME=deepseek-chat

# --------------------------------------------------------------
# Embedding（可选；不配置则用「本地 BGE」或「哈希向量器」兜底）
# --------------------------------------------------------------
# 仅当 EMBEDDING_API_KEY 与 EMBEDDING_BASE_URL 都非空时才会启用 API 这一级
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# ⚠️ 该维度必须与所选模型的实际输出维度一致，否则向量检索会失效。
#   例：text-embedding-3-small = 1536、bge-small-zh-v1.5 = 512。
#   它同时决定「哈希向量器兜底」的维度；本地 BGE 按实际维度自动识别、忽略本项。
EMBEDDING_DIM=256

# --------------------------------------------------------------
# 本地模型（BGE，离线优先；第三阶段）
# --------------------------------------------------------------
# 模型根目录，其下按模型名建子目录（见下两行）
LOCAL_MODELS_DIR=local_models/models
LOCAL_EMBEDDING_MODEL=BAAI--bge-small-zh-v1.5
LOCAL_RERANKER_MODEL=BAAI--bge-reranker-base
# 开关取值：auto = 模型文件存在就用，否则自动降级（推荐）
#           on   = 强制使用（模型缺失会报错）
#           off  = 禁用，走下一级
USE_LOCAL_EMBEDDING=auto
USE_LOCAL_RERANKER=auto
# 推理设备：cpu / cuda（无独显请保持 cpu）
ML_DEVICE=cpu

# --------------------------------------------------------------
# 服务参数
# --------------------------------------------------------------
# 提问长度上限（字符），超出返回 400
MAX_QUESTION_LEN=2000
# 默认取 Top-K 条款作为回答证据，同时用于评测 Recall@K
TOP_K=5
# 多轮会话携带的历史消息条数上限（用于指代改写）
SESSION_HISTORY_LIMIT=20
# 日志级别：DEBUG / INFO / WARNING / ERROR（输出为单行 JSON，走 stdout）
LOG_LEVEL=INFO

# --------------------------------------------------------------
# CORS（前端独立部署时的跨域来源，逗号分隔）
# --------------------------------------------------------------
# 前后端同源部署（nginx 反代 /api）时其实用不到；
# 本地开发填 http://localhost:5500 这类值即可。
# ⚠️ 生产环境不要用 "*" 全放行，应收紧到具体域名。
CORS_ORIGINS=*

# --------------------------------------------------------------
# Dify 外部知识库适配（可选）
# --------------------------------------------------------------
# 把本系统的混合检索按 Dify External Knowledge API 协议暴露为 /dify/retrieval，
# 供 Dify 的「知识检索」节点当作外部知识库调用。
# 留空 = 不注册该路由（默认）；填任意随机字符串 = 启用，且 Dify 侧 API Key 必须与此完全一致。
# ⚠️ 这是一个口令（shared secret），请只写在 .env 里，不要填进本示例文件。
DIFY_RETRIEVAL_API_KEY=
# /dify/retrieval 允许返回的最大条数上限（Dify 侧请求的 top_k 会被此值截断）
DIFY_MAX_TOP_K=20

# ==============================================================
# 降级链（一切留空也能跑，系统按下面顺序自动退）
# --------------------------------------------------------------
# Embedding： 本地 BGE(512 维) → Embedding API → 确定性哈希向量器（离线兜底）
#   · 选型期：启动时按上述优先级挑一个实例
#   · 运行期：向量这一路抛异常会自动降为「关键词单路」，问答不中断
# LLM：       可用则生成答案 → 不可用则退化为「原文摘编」（附条款原文）
# 检索：      关键词 + 向量双路 → RRF 融合 → 可选 BGE-reranker 重排
# ==============================================================
